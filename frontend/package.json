    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.18.1",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@tailwindcss/vite": "^4.3.2",
